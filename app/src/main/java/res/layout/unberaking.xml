<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<ScrollView
		android:id="@+id/vscroll1"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:padding="8dp">
		<LinearLayout
			android:id="@+id/linear39"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="#FFFFFF"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear33"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/imageview25"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/book"
					android:scaleType="fitCenter"
					android:layout_gravity="top" />
				<TextView
					android:id="@+id/textview2"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="center_horizontal"
					android:text="Unbreaking"
					android:textSize="18sp"
					android:textStyle="bold|italic"
					android:textColor="#000000"
					android:layout_weight="100" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview3"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="right"
				android:text="زیاد کردنی خوێنی(ڕێژەی مانەوەی)\nکاتێک بەکاری دەهێنیت."
				android:textSize="20sp"
				android:textStyle="bold"
				android:textColor="#000000"
				android:layout_gravity="right" />
			<LinearLayout
				android:id="@+id/linear34"
				android:layout_width="match_parent"
				android:layout_height="20dp"
				android:padding="8dp"
				android:orientation="horizontal" />
			<TextView
				android:id="@+id/textview5"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="بۆ درعەکان\nئاست I: هەل %20\nئاست II: هەل %27\nئاست III: هەل %30\n\nبۆ کەلو پەل/ئامراز\n\nئاست I: هەل %50\nئاست II: هەل %67\nئاست III: هەل %75"
				android:textSize="20sp"
				android:textStyle="bold"
				android:textColor="#000000"
				android:layout_gravity="right" />
			<LinearLayout
				android:id="@+id/linear35"
				android:layout_width="match_parent"
				android:layout_height="20dp"
				android:padding="8dp"
				android:orientation="horizontal" />
			<TextView
				android:id="@+id/textview6"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="هەموو جۆرە درعێک و ئامرازێک و کەڵوپەلانە Unbreaking ـی دەخرێتە سەر."
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#000000"
				android:layout_gravity="right" />
			<LinearLayout
				android:id="@+id/linear40"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal">
				<ImageView
					android:id="@+id/hilmat"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/ite_3"
					android:scaleType="centerCrop"
					android:translationX="15.0dp"
					android:layout_gravity="center_horizontal" />
				<ImageView
					android:id="@+id/dr3"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/ite_2"
					android:scaleType="centerCrop"
					android:translationX="35.0dp" />
				<ImageView
					android:id="@+id/bejama"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/ite_1"
					android:scaleType="centerCrop"
					android:translationX="50.0dp" />
				<ImageView
					android:id="@+id/pelaw"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/hue_3"
					android:scaleType="centerCrop"
					android:translationX="60.0dp" />
				<ImageView
					android:id="@+id/skip"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/tyu"
					android:scaleType="centerCrop"
					android:translationX="70.0dp" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear45"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal">
				<ImageView
					android:id="@+id/imageview27"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/dia_4"
					android:scaleType="centerCrop"
					android:translationX="10.0dp"
					android:layout_gravity="center_horizontal" />
				<ImageView
					android:id="@+id/imageview28"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/dia_1"
					android:scaleType="centerCrop"
					android:translationX="30.0dp" />
				<ImageView
					android:id="@+id/imageview29"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/dia_2"
					android:scaleType="centerCrop"
					android:translationX="50.0dp" />
				<ImageView
					android:id="@+id/imageview30"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/dia_3"
					android:scaleType="centerCrop"
					android:translationX="60.0dp" />
				<ImageView
					android:id="@+id/imageview31"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/ytu"
					android:scaleType="centerCrop"
					android:translationX="70.0dp" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear46"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal">
				<ImageView
					android:id="@+id/imageview32"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/fish_2"
					android:scaleType="centerCrop"
					android:translationX="5.0dp"
					android:layout_gravity="center_horizontal" />
				<ImageView
					android:id="@+id/imageview33"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/ite_4"
					android:scaleType="centerCrop"
					android:translationX="10.0dp" />
				<ImageView
					android:id="@+id/imageview34"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/gtr"
					android:scaleType="centerCrop"
					android:translationX="15.0dp" />
				<ImageView
					android:id="@+id/imageview35"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/fish_1"
					android:scaleType="centerCrop"
					android:translationX="20.0dp" />
				<ImageView
					android:id="@+id/imageview36"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/hue_2"
					android:scaleType="centerCrop"
					android:translationX="25.0dp" />
				<ImageView
					android:id="@+id/imageview47"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/hue_1"
					android:scaleType="centerCrop"
					android:translationX="20.0dp" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
