<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear3"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:background="#00E676"
		android:orientation="horizontal">
		<Button
			android:id="@+id/button30"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="@android:color/transparent"
			android:text="بسم اللە الرحمان الرحیم "
			android:textSize="20sp"
			android:textStyle="bold"
			android:textColor="#000000" />
	</LinearLayout>
	<ScrollView
		android:id="@+id/vscroll3"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp">
		<LinearLayout
			android:id="@+id/linear8"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="8dp"
			android:background="#000000"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:background="#00E676"
				android:gravity="center_horizontal"
				android:text="سەرەتا سوپاس بۆ خوای گەورە کە توانیم بەم بەرنامە بەسوودە دروست کەم بۆ ئێوەی خۆشەویست بەهیوای سودی لێ بینن.\n\nتایبەتمەندییەکانی بەرنامەکە:\n\n1- تەواوی بەرنامەکە بە زمانی کوردی داڕێژراوە.\n\n2- زانیاری تەواو لەسەر هەموو کتێبە سحراوییەکانی ماینکرافت.\n\n3- زانیاری تەواو لەسەر هەموو دەرمانەکان.\n\n4- نوێترین و باشترین ڕێگاکانی دۆزینەوەی کانزاکان،\n\nئەم ئەپە دروست کراوە لە لایەن[ZHIWAR YT] Create by"
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:layout_gravity="center_horizontal" />
			<LinearLayout
				android:id="@+id/linear9"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="8dp"
				android:background="#FFFFFF"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear10"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="vertical">
					<ImageView
						android:id="@+id/imageview9"
						android:layout_width="45dp"
						android:layout_height="50dp"
						android:src="@drawable/myu"
						android:scaleType="centerInside"
						android:translationY="50.0dp" />
					<Button
						android:id="@+id/button28"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:padding="8dp"
						android:background="@android:color/transparent"
						android:gravity="right"
						android:text="من لە YOUTUBE"
						android:textSize="20sp"
						android:textStyle="bold"
						android:textColor="#000000"
						android:layout_gravity="right" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear12"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal" />
				<LinearLayout
					android:id="@+id/linear11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="vertical">
					<ImageView
						android:id="@+id/imageview10"
						android:layout_width="45dp"
						android:layout_height="45dp"
						android:src="@drawable/facbook_1"
						android:scaleType="centerInside"
						android:translationY="45.0dp" />
					<Button
						android:id="@+id/button29"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:padding="8dp"
						android:background="@android:color/transparent"
						android:gravity="right"
						android:text="من لە FACEBOOK"
						android:textSize="20sp"
						android:textStyle="bold"
						android:textColor="#000000"
						android:layout_gravity="right" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
