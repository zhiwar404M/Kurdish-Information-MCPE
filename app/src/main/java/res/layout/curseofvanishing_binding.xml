<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear47"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:background="#000000"
		android:gravity="center_vertical"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear22"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="#F44336"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:layout_gravity="center_vertical">
			<ImageView
				android:id="@+id/imageview14"
				android:layout_width="50dp"
				android:layout_height="50dp"
				android:src="@drawable/book"
				android:scaleType="fitCenter"
				android:layout_gravity="top" />
			<Button
				android:id="@+id/button23"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:background="@android:color/transparent"
				android:text="Curse of | Vanishing &amp; Binding"
				android:textSize="18sp"
				android:textStyle="bold|italic"
				android:textColor="#FFFFFF"
				android:layout_gravity="center_horizontal" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear45"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="#FFFFFF"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview6"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="ئەم کتێبانە نەفرەت لێکراون❗\n\nگەر بمریت (بدۆڕێیت) ئەوا ناتوانیت جارێکی دیکە ئەو ئامێرە(ئامراز) ـە هەڵبگریتەوە! کە ئەم دووجۆرە کتێبی لەسەر بێت!"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#000000"
				android:layout_gravity="right" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear44"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="#FFFFFF"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview7"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:background="#FFFFFF"
				android:text="*بەپێی ئەو زانییاریانەی کە دەستمان کەوتوە"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#000000"
				android:alpha="0.5"
				android:layout_gravity="right" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
